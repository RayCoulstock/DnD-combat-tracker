DATABASE_URL=postgresql://ledger:ledger_dev_only@127.0.0.1:5432/ledger
# Generate a unique value: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
# Defaults true outside production; set false to test private-beta registration closure.
ALLOW_DM_REGISTRATION=true
# Codespaces: APP_ORIGIN=https://YOUR-CODESPACE-5173.app.github.dev
# Keep forwarded ports private; share access using Codespaces permissions.

# Must be outside this application directory. Persist and back up with PostgreSQL.
ASSET_STORAGE_DIR=../.ledger-assets
# Limits are bytes/counts/pixels; raising them increases memory/GPU requirements.
ASSET_MAX_BYTES=26214400
ASSET_MAX_VERTICES=500000
ASSET_MAX_TRIANGLES=500000
ASSET_MAX_NODES=1000
ASSET_MAX_MATERIALS=128
ASSET_MAX_ANIMATIONS=16
ASSET_MAX_TEXTURES=64
ASSET_MAX_TEXTURE_DIMENSION=4096
ASSET_MAX_TEXTURE_PIXELS=67108864
ASSET_VALIDATION_TIMEOUT_MS=15000
