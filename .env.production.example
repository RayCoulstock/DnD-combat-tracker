# TEMPLATE ONLY. Copy outside the checkout/image as a mode-0600 runtime env file.
# Never pass these as Docker build arguments or prefix secrets with VITE_.
NODE_ENV=production
# Private beta: existing DM login and player invitations remain available.
ALLOW_DM_REGISTRATION=false
PORT=3001
# URL-encode password characters. Use a private PostgreSQL 17 service/network.
# For a remote database, use verified TLS and its CA; never disable certificate verification.
DATABASE_URL=postgresql://ledger:REPLACE_WITH_URL_ENCODED_RANDOM_PASSWORD@postgres:5432/ledger
# For the standalone production Compose PostgreSQL service; not read by the application.
POSTGRES_USER=ledger
POSTGRES_DB=ledger
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# Generate independently: openssl rand -hex 32. Keep stable across restarts.
SESSION_SECRET=replace-with-a-unique-random-session-secret
# Exact public HTTPS origin, no path or trailing slash. Controls cookies, CSRF, invites and sockets.
APP_ORIGIN=https://ledger.example.com
# 1 = exactly one Caddy hop on a private Docker network (Node must not be public).
# loopback = host-local proxy; 0 = no trusted proxy. Never accept arbitrary forwarded headers.
TRUST_PROXY=1
# Mount a persistent named volume, writable by container UID/GID 1000:1000.
# Back up together with PostgreSQL; never use the container writable layer for uploads.
ASSET_STORAGE_DIR=/var/lib/encounter-ledger/assets
# Validation limits: bytes, counts, pixels and milliseconds. Increasing them raises memory/GPU use.
ASSET_MAX_BYTES=26214400
ASSET_MAX_VERTICES=500000
ASSET_MAX_TRIANGLES=500000
ASSET_MAX_NODES=1000
ASSET_MAX_MATERIALS=128
ASSET_MAX_ANIMATIONS=16
ASSET_MAX_TEXTURES=64
ASSET_MAX_TEXTURE_DIMENSION=4096
ASSET_MAX_TEXTURE_PIXELS=67108864
ASSET_VALIDATION_TIMEOUT_MS=15000
# Do not set SEED_DM_EMAIL or SEED_DM_PASSWORD in production. Seed is development-only.

# PR 2 standalone compose.production.yaml; use scripts/ops/compose.sh, never merge with compose.yaml.
# Use the SAME host here and in APP_ORIGIN; no path, port or trailing slash in LEDGER_DOMAIN.
LEDGER_DOMAIN=ledger.example.com
ACME_EMAIL=operator@example.com
# Pull/build and smoke-test first; production preflight requires an immutable digest.
LEDGER_IMAGE=ghcr.io/YOUR_ACCOUNT/encounter-ledger@sha256:REPLACE_WITH_VERIFIED_IMAGE_DIGEST
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
# 32 MiB leaves space for the default 25 MiB GLB and multipart framing.
MAX_REQUEST_BODY_BYTES=33554432
APP_MEMORY_LIMIT=1536m
POSTGRES_MEMORY_LIMIT=768m
CADDY_MEMORY_LIMIT=256m
# Production ports. Overrides exist solely for an isolated loopback smoke/restore exercise.
LEDGER_BIND_IP=0.0.0.0
LEDGER_HTTP_PORT=80
LEDGER_HTTPS_PORT=443
