# Private backup config, outside Git and chmod 600. Literal KEY=value only; no shell expansion.
# Create the repository explicitly after approving its bucket/policy; scripts never init or prune it.
RESTIC_REPOSITORY=s3:https://nyc3.digitaloceanspaces.com/YOUR_BACKUP_BUCKET/encounter-ledger
RESTIC_PASSWORD_FILE=/etc/encounter-ledger/restic-password
AWS_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_SPACES_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_SPACES_SECRET
AWS_DEFAULT_REGION=nyc3
# Local cache is disposable; password loss makes backups unrecoverable.
RESTIC_CACHE_DIR=/var/cache/encounter-ledger/restic
