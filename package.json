{
  "name": "dnd-combat-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p server/tsconfig.json && cp -r server/migrations dist-server/server/",
    "lint": "eslint .",
    "test": "node --test src/mapState.test.ts src/App.test.js && tsx --test shared/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:server\"",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test:integration": "tsx --env-file-if-exists=.env --test server/tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/seed.ts",
    "test:e2e": "playwright test",
    "db:migrate:production": "node --env-file-if-exists=.env dist-server/server/migrate.js"
  },
  "dependencies": {
    "@react-three/drei": "10.0.6",
    "@react-three/fiber": "9.1.2",
    "@vitejs/plugin-react": "latest",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.176.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "22.15.3",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/three": "0.176.0",
    "concurrently": "^9.2.5",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=24"
  }
}
